`timescale 1ns/1ps

module fft64_q214_top (
    input  clk,
    input  signed [15:0] in_r [0:63],
    input  signed [15:0] in_i [0:63],
    input  [5:0] sel,
    output reg signed [15:0] out_r,
    output reg signed [15:0] out_i
);

    // Bit-reversed input
    wire signed [15:0] xr[0:63], xi[0:63];

    bit_reverse_64 BR64 (
        .in_r(in_r),
        .in_i(in_i),
        .out_r(xr),
        .out_i(xi)
    );

    // Twiddle ROM
    wire signed [15:0] tw_r[0:31], tw_i[0:31];

    genvar t;
    generate
        for (t=0; t<32; t=t+1) begin : TW
            twiddle_rom_64 TROM(t[4:0], tw_r[t], tw_i[t]);
        end
    endgenerate

    genvar i;

    // STAGE 1 
    wire signed [17:0] s1wr[0:63], s1wi[0:63];
    wire signed [15:0] s1r [0:63], s1i [0:63];

    generate
        for (i=0; i<32; i=i+1) begin
            bfly_radix2_q214 BF1(
                xr[2*i], xi[2*i],
                xr[2*i+1], xi[2*i+1],
                tw_r[0], tw_i[0],
                s1wr[2*i], s1wi[2*i],
                s1wr[2*i+1], s1wi[2*i+1]
            );
        end
        for (i=0;i<64;i=i+1)
            scale_by_2 SC1(s1wr[i], s1wi[i], s1r[i], s1i[i]);
    endgenerate

    // STAGE 2 
    wire signed [17:0] s2wr[0:63], s2wi[0:63];
    wire signed [15:0] s2r [0:63], s2i [0:63];

    generate
        for (i=0;i<16;i=i+1) begin
            bfly_radix2_q214 BF2A(
                s1r[4*i], s1i[4*i],
                s1r[4*i+2], s1i[4*i+2],
                tw_r[0], tw_i[0],
                s2wr[4*i], s2wi[4*i],
                s2wr[4*i+2], s2wi[4*i+2]
            );
            bfly_radix2_q214 BF2B(
                s1r[4*i+1], s1i[4*i+1],
                s1r[4*i+3], s1i[4*i+3],
                tw_r[16], tw_i[16],
                s2wr[4*i+1], s2wi[4*i+1],
                s2wr[4*i+3], s2wi[4*i+3]
            );
        end
        for (i=0;i<64;i=i+1)
            scale_by_2 SC2(s2wr[i], s2wi[i], s2r[i], s2i[i]);
    endgenerate

    // STAGE 3 
    wire signed [17:0] s3wr[0:63], s3wi[0:63];
    wire signed [15:0] s3r [0:63], s3i [0:63];

    generate
        for (i=0;i<8;i=i+1) begin
            bfly_radix2_q214 BF3A(
                s2r[8*i], s2i[8*i],
                s2r[8*i+4], s2i[8*i+4],
                tw_r[0], tw_i[0],
                s3wr[8*i], s3wi[8*i],
                s3wr[8*i+4], s3wi[8*i+4]
            );
            bfly_radix2_q214 BF3B(
                s2r[8*i+1], s2i[8*i+1],
                s2r[8*i+5], s2i[8*i+5],
                tw_r[8], tw_i[8],
                s3wr[8*i+1], s3wi[8*i+1],
                s3wr[8*i+5], s3wi[8*i+5]
            );
            bfly_radix2_q214 BF3C(
                s2r[8*i+2], s2i[8*i+2],
                s2r[8*i+6], s2i[8*i+6],
                tw_r[16], tw_i[16],
                s3wr[8*i+2], s3wi[8*i+2],
                s3wr[8*i+6], s3wi[8*i+6]
            );
            bfly_radix2_q214 BF3D(
                s2r[8*i+3], s2i[8*i+3],
                s2r[8*i+7], s2i[8*i+7],
                tw_r[24], tw_i[24],
                s3wr[8*i+3], s3wi[8*i+3],
                s3wr[8*i+7], s3wi[8*i+7]
            );
        end
        for (i=0;i<64;i=i+1)
            scale_by_2 SC3(s3wr[i], s3wi[i], s3r[i], s3i[i]);
    endgenerate

    // STAGE 4 (span = 8)
    wire signed [17:0] s4wr[0:63], s4wi[0:63];
    wire signed [15:0] s4r [0:63], s4i [0:63];

    generate
        for (i=0;i<4;i=i+1) begin
            integer k;
            for (k=0;k<8;k=k+1) begin
                bfly_radix2_q214 BF4(
                    s3r[16*i+k], s3i[16*i+k],
                    s3r[16*i+k+8], s3i[16*i+k+8],
                    tw_r[4*k], tw_i[4*k],
                    s4wr[16*i+k], s4wi[16*i+k],
                    s4wr[16*i+k+8], s4wi[16*i+k+8]
                );
            end
        end
        for (i=0;i<64;i=i+1)
            scale_by_2 SC4(s4wr[i], s4wi[i], s4r[i], s4i[i]);
    endgenerate

    // STAGE 5
    wire signed [17:0] s5wr[0:63], s5wi[0:63];
    wire signed [15:0] s5r [0:63], s5i [0:63];

    generate
        for (i=0;i<16;i=i+1) begin
            bfly_radix2_q214 BF5A(
                s4r[i], s4i[i],
                s4r[i+16], s4i[i+16],
                tw_r[2*i], tw_i[2*i],
                s5wr[i], s5wi[i],
                s5wr[i+16], s5wi[i+16]
            );
            bfly_radix2_q214 BF5B(
                s4r[i+32], s4i[i+32],
                s4r[i+48], s4i[i+48],
                tw_r[2*i], tw_i[2*i],
                s5wr[i+32], s5wi[i+32],
                s5wr[i+48], s5wi[i+48]
            );
        end
        for (i=0;i<64;i=i+1)
            scale_by_2 SC5(s5wr[i], s5wi[i], s5r[i], s5i[i]);
    endgenerate

    // STAGE 6 
    wire signed [17:0] s6wr[0:63], s6wi[0:63];
    wire signed [15:0] s6r [0:63], s6i [0:63];

    generate
        for (i=0;i<32;i=i+1) begin
            bfly_radix2_q214 BF6(
                s5r[i], s5i[i],
                s5r[i+32], s5i[i+32],
                tw_r[i], tw_i[i],
                s6wr[i], s6wi[i],
                s6wr[i+32], s6wi[i+32]
            );
        end
        for (i=0;i<64;i=i+1)
            scale_by_2 SC6(s6wr[i], s6wi[i], s6r[i], s6i[i]);
    endgenerate

    // Output select
    always @(posedge clk) begin
        out_r <= s6r[sel];
        out_i <= s6i[sel];
    end

endmodule
